<!doctype html>
<html>
<head>
  <meta charset="utf-8">
  <link rel="stylesheet" href="{{.Stylesheet}}">
</head>
<body>
  <main class="card rarity-{{.Rarity.ID}}" style="--c: {{.Rarity.Color}}">
    <div class="art"><img src="{{.ArtURL}}" alt=""></div>

    <section class="panel">
      <header class="title">
        <h1 class="name">{{.Card.Name}}</h1>
        {{- if .Element}}
        <span class="element element-{{.Element.ID}}">{{inline .Element.Icon}}</span>
        {{- end}}
      </header>
      {{- if .Card.Description}}
      <p class="description">{{.Card.Description}}</p>
      {{- end}}
    </section>

    <!-- drawn before the shared frame so its edges stay on top -->
    <svg class="frame" viewBox="0 0 722 1022" aria-hidden="true">
      <!-- bar between artwork and text panel -->
      <rect class="separator" x="20" y="662" width="682" height="16"/>
      <path class="edge-lit" d="M20,662.75 H702 M20,677.25 H702"/>
      <!-- inset box around the text panel -->
      <rect class="panel-line" x="32" y="690" width="658" height="300" rx="10"/>
    </svg>
    {{inline "frame.svg"}}

    <div class="ornaments">{{inline .Rarity.Frame}}</div>

    {{- if .Card.Number}}
    <div class="number">{{printf "%03d" .Card.Number}}</div>
    {{- end}}
  </main>
</body>
</html>

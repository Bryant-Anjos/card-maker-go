<!doctype html>
<html>
<head>
  <meta charset="utf-8">
  <link rel="stylesheet" href="{{.Stylesheet}}">
  <style>
    .back { --c: #e4b85a; background: radial-gradient(120% 90% at 50% 45%, #1d3157 0%, #142443 45%, #0c172d 100%); }
  </style>
</head>
<body>
  <main class="card back">
    <svg class="frame" viewBox="0 0 722 1022" aria-hidden="true">
      <defs>
        <linearGradient id="gold" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0" stop-color="#fff0b8"/>
          <stop offset="0.45" stop-color="#e4b85a"/>
          <stop offset="1" stop-color="#a5741f"/>
        </linearGradient>
        <g id="back-corner">
          <path fill="none" stroke="#e4b85a" stroke-width="3" d="M44,120 V70 L70,44 H120"/>
          <path fill="none" stroke="#e4b85a" stroke-width="1.6" stroke-opacity="0.85" d="M58,96 V78 L78,58 H96"/>
          <polygon fill="url(#gold)" points="56,48 64,56 56,64 48,56"/>
          <path fill="none" stroke="#e4b85a" stroke-width="1.6" stroke-opacity="0.85" d="M44,150 C60,140 64,126 56,112 M150,44 C140,60 126,64 112,56"/>
        </g>
        <g id="back-ray">
          <polygon fill="url(#gold)" points="361,250 381,490 361,511 341,490"/>
        </g>
        <g id="back-ray-short">
          <polygon fill="url(#gold)" points="361,390 371,496 361,511 351,496" transform="rotate(45 361 511)"/>
        </g>
      </defs>

      <!-- outer metal band, as on the card front -->
      <path fill="url(#gold)" fill-rule="evenodd" d="
        M24,0 H698 A24,24 0 0 1 722,24 V998 A24,24 0 0 1 698,1022 H24 A24,24 0 0 1 0,998 V24 A24,24 0 0 1 24,0 Z
        M26,10 H696 A16,16 0 0 1 712,26 V996 A16,16 0 0 1 696,1012 H26 A16,16 0 0 1 10,996 V26 A16,16 0 0 1 26,10 Z"/>
      <rect fill="none" stroke="#e4b85a" stroke-width="1.6" stroke-opacity="0.85" x="30" y="30" width="662" height="962" rx="10"/>

      <!-- corner flourishes -->
      <use href="#back-corner"/>
      <use href="#back-corner" transform="translate(722,0) scale(-1,1)"/>
      <use href="#back-corner" transform="translate(0,1022) scale(1,-1)"/>
      <use href="#back-corner" transform="translate(722,1022) scale(-1,-1)"/>

      <!-- vertical axis with small stars -->
      <path fill="none" stroke="#e4b85a" stroke-width="1.6" stroke-opacity="0.85" d="M361,70 V200 M361,822 V952"/>
      <path fill="url(#gold)" d="M361,150 L366,170 L361,190 L356,170 Z M361,832 L366,852 L361,872 L356,852 Z"/>

      <!-- compass rings -->
      <circle fill="none" stroke="#e4b85a" stroke-width="3" cx="361" cy="511" r="215"/>
      <circle fill="none" stroke="#e4b85a" stroke-width="1.6" stroke-opacity="0.85" cx="361" cy="511" r="198"/>
      <circle fill="none" stroke="#e4b85a" stroke-width="1.2" stroke-opacity="0.35" cx="361" cy="511" r="150"/>
      <g fill="url(#gold)">
        <polygon points="361,284 372,296 361,308 350,296"/>
        <polygon points="361,714 372,726 361,738 350,726"/>
        <polygon points="134,511 146,500 158,511 146,522"/>
        <polygon points="564,511 576,500 588,511 576,522"/>
      </g>

      <!-- compass star: four long rays and four short diagonal rays -->
      <use href="#back-ray-short"/>
      <use href="#back-ray-short" transform="rotate(90 361 511)"/>
      <use href="#back-ray-short" transform="rotate(180 361 511)"/>
      <use href="#back-ray-short" transform="rotate(270 361 511)"/>
      <use href="#back-ray"/>
      <use href="#back-ray" transform="rotate(90 361 511)"/>
      <use href="#back-ray" transform="rotate(180 361 511)"/>
      <use href="#back-ray" transform="rotate(270 361 511)"/>
      <circle cx="361" cy="511" r="12" fill="#fff4cc"/>
    </svg>
  </main>
</body>
</html>

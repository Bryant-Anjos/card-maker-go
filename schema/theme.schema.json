{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://card-maker-go/schema/theme.schema.json",
  "title": "Theme definition",
  "description": "Visual definition of a card set. All paths are relative to the theme directory.",
  "type": "object",
  "required": [
    "schemaVersion",
    "name",
    "size",
    "template",
    "stylesheet",
    "rarities"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Optional path or URL of this schema, used by editors for autocompletion. Ignored by the program."
    },
    "schemaVersion": {
      "const": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "size": {
      "$ref": "defs.schema.json#/$defs/size"
    },
    "template": {
      "$ref": "defs.schema.json#/$defs/relativePath"
    },
    "stylesheet": {
      "$ref": "defs.schema.json#/$defs/relativePath"
    },
    "back": {
      "$ref": "defs.schema.json#/$defs/relativePath"
    },
    "rarities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "color",
          "frame"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "defs.schema.json#/$defs/identifier"
          },
          "label": {
            "$ref": "defs.schema.json#/$defs/localizedText"
          },
          "color": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$"
          },
          "frame": {
            "$ref": "defs.schema.json#/$defs/relativePath"
          }
        }
      }
    },
    "elements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "icon"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "defs.schema.json#/$defs/identifier"
          },
          "label": {
            "$ref": "defs.schema.json#/$defs/localizedText"
          },
          "icon": {
            "$ref": "defs.schema.json#/$defs/relativePath"
          }
        }
      }
    }
  }
}

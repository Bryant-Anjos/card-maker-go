{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://card-maker-go/schema/cards.schema.json",
  "title": "Cards data file",
  "description": "Input data for the cards to render. Art paths are relative to the directory of this file. Rarity, element and variant ids must exist in the theme used for rendering.",
  "type": "object",
  "required": [
    "schemaVersion",
    "cards"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Optional path or URL of this schema, used by editors for autocompletion. Ignored by the program."
    },
    "schemaVersion": {
      "const": 1
    },
    "cards": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/card"
      }
    }
  },
  "$defs": {
    "card": {
      "type": "object",
      "required": [
        "id",
        "rarity",
        "name",
        "art"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "defs.schema.json#/$defs/identifier"
        },
        "number": {
          "type": "integer",
          "minimum": 0,
          "description": "Collection number. Omit or 0 for none."
        },
        "rarity": {
          "$ref": "defs.schema.json#/$defs/identifier"
        },
        "element": {
          "$ref": "defs.schema.json#/$defs/identifier"
        },
        "variant": {
          "$ref": "defs.schema.json#/$defs/identifier",
          "description": "Alternative layout defined by the theme, such as fullart. Omit for the standard layout."
        },
        "name": {
          "$ref": "defs.schema.json#/$defs/localizedText",
          "minProperties": 1
        },
        "description": {
          "$ref": "defs.schema.json#/$defs/localizedText"
        },
        "art": {
          "$ref": "defs.schema.json#/$defs/relativePath"
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://card-maker-go/schema/manifest.schema.json",
  "title": "Output manifest",
  "description": "Describes the rendered cards for one theme and locale. This is the contract consumed by every client platform. Image paths are relative to the directory containing the manifest; texts are already resolved for the locale.",
  "type": "object",
  "required": ["schemaVersion", "theme", "locale", "size", "cards"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "theme": { "type": "string", "minLength": 1 },
    "locale": { "$ref": "defs.schema.json#/$defs/locale" },
    "size": { "$ref": "defs.schema.json#/$defs/size" },
    "back": { "$ref": "#/$defs/image" },
    "cards": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "rarity", "name", "images"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "defs.schema.json#/$defs/identifier" },
          "number": { "type": "integer", "minimum": 0 },
          "rarity": { "$ref": "defs.schema.json#/$defs/identifier" },
          "element": { "$ref": "defs.schema.json#/$defs/identifier" },
          "name": { "type": "string", "minLength": 1 },
          "description": { "type": "string" },
          "images": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/image" } }
        }
      }
    }
  },
  "$defs": {
    "image": {
      "type": "object",
      "required": ["scale", "format", "path", "width", "height"],
      "additionalProperties": false,
      "properties": {
        "scale": { "type": "integer", "minimum": 1 },
        "format": { "enum": ["png", "webp"] },
        "path": { "$ref": "defs.schema.json#/$defs/relativePath" },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
